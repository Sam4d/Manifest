{
  "name": "pagetrace",
  "version": "0.5.2",
  "description": "Website capture, structure analysis and AI-ready source export for Windows",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "package": "electron-builder --dir",
    "dist": "electron-builder",
    "test:desktop": "electron scripts/desktop-smoke.cjs",
    "postinstall": "node node_modules/electron/install.js",
    "test:desktop:ci": "electron --no-sandbox --disable-gpu scripts/desktop-smoke.cjs",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "test:capture:desktop": "electron scripts/capture-smoke.cjs",
    "test:capture:desktop:ci": "electron --no-sandbox --disable-gpu scripts/capture-smoke.cjs",
    "test:packaged": "node scripts/packaged-smoke.cjs"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.pagetrace.desktop",
    "productName": "PageTrace",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "PageTrace-${version}-${arch}-Setup.${ext}",
      "signExecutable": false
    },
    "icon": "src/assets/icon.png",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "PageTrace-${version}-${arch}-portable.exe"
    },
    "electronLanguages": [
      "en-US"
    ],
    "extraResources": [
      {
        "from": "vendor/httrack",
        "to": "httrack",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "parse5": "^8.0.1"
  },
  "author": "PageTrace contributors",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "website-analyzer",
    "offline",
    "website-structure",
    "manifest",
    "html",
    "css",
    "asset-inventory",
    "website-reconstruction",
    "ai-context",
    "electron",
    "desktop",
    "windows"
  ]
}
